      "types": "./dist/period.d.mts",
      "default": "./dist/period.mjs"
    },
    "./calendar": {
      "types": "./dist/calendar.d.mts",
      "default": "./dist/calendar.mjs"
    },
    "./timezone": {
      "types": "./dist/timezone.d.mts",
      "default": "./dist/timezone.mjs"
    },
    "./reference": {
      "types": "./dist/reference.d.mts",
      "default": "./dist/reference.mjs"
    },
    "./context": {
      "types": "./dist/context.d.mts",
      "default": "./dist/context.mjs"
    },
    "./events": {
      "types": "./dist/events.d.mts",
      "default": "./dist/events.mjs"
    },
    "./event-infra": {
      "types": "./dist/event-infra.d.mts",
