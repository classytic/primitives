{
  "name": "@classytic/primitives",
  "version": "0.14.0",
  "description": "Framework-agnostic TypeScript primitives shared across Classytic packages — Money, events, pagination, tenant config, and other building blocks.",
  "author": "Classytic",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/@classytic/primitives",
  "bugs": {
    "url": "https://github.com/classytic/primitives/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classytic/primitives.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./money": {
      "types": "./dist/money.d.mts",
      "default": "./dist/money.mjs"
    },
