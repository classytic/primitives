    },
    "./phone": {
      "types": "./dist/phone.d.mts",
      "default": "./dist/phone.mjs"
    },
    "./status-history": {
      "types": "./dist/status-history.d.mts",
      "default": "./dist/status-history.mjs"
    },
    "./condition": {
      "types": "./dist/condition.d.mts",
