  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project integration",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "push": "classytic-push",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run test:smoke",
    "release": "npm run build && npm run typecheck && npm publish --access public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@classytic/dev-tools": "^0.2.0",
    "@types/node": "^25.5.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "typescript",
    "types",
    "primitives",
    "money",
    "currency",
    "pagination",
    "domain-event",
    "tenant",
    "classytic",
    "commerce"
  ]
}
